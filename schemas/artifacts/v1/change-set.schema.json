{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign.ai/schemas/artifacts/v1/change-set.schema.json",
  "title": "change-set/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "summary", "baseCommit", "changeRequestDigest", "implementationPlanDigest", "patch", "patchDigest", "files", "byteCount", "lineCounts"],
  "properties": {
    "format": {"const": "unified-diff"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1024},
    "baseCommit": {"$ref": "common.schema.json#/$defs/GitOID"},
    "changeRequestDigest": {"$ref": "common.schema.json#/$defs/Digest"},
    "implementationPlanDigest": {"$ref": "common.schema.json#/$defs/Digest"},
    "patch": {"type": "string", "minLength": 1, "maxLength": 262144},
    "patchDigest": {"$ref": "common.schema.json#/$defs/Digest"},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/RepositoryRelativePath"}
    },
    "byteCount": {"type": "integer", "minimum": 1, "maximum": 262144},
    "lineCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "deleted"],
      "properties": {
        "added": {"type": "integer", "minimum": 0},
        "deleted": {"type": "integer", "minimum": 0}
      }
    }
  }
}
