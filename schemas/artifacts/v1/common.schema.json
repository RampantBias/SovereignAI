{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign.ai/schemas/artifacts/v1/common.schema.json",
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "GitOID": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "RepositoryURL": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/?#@]+/[^?#]+$",
      "maxLength": 2048
    },
    "OCIRepository": {
      "type": "string",
      "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*(:[0-9]+)?(/[a-z0-9]+([._-][a-z0-9]+)*)+$",
      "maxLength": 255
    },
    "ObjectIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "name", "uid"],
      "properties": {
        "namespace": {"type": "string", "minLength": 1, "maxLength": 63},
        "name": {"type": "string", "minLength": 1, "maxLength": 253},
        "uid": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "RepositoryRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^/\\\\][^\\\\]*$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "Branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "SovereignBranch": {
      "type": "string",
      "minLength": 11,
      "maxLength": 255,
      "pattern": "^sovereign/[A-Za-z0-9][A-Za-z0-9._/-]*$"
    }
  }
}
