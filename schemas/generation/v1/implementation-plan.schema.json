{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign.ai/schemas/artifacts/v1/implementation-plan.generation.schema.json",
  "title": "implementation-plan/v1 model generation",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "affectedPaths", "implementationSteps", "testStrategy", "acceptanceMapping", "risks", "assumptions"],
  "properties": {
    "summary": {"type": "string", "minLength": 1, "maxLength": 1024},
    "affectedPaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "action"],
        "properties": {
          "path": {"$ref": "common.schema.json#/$defs/RepositoryRelativePath"},
          "action": {"enum": ["add", "modify", "delete"]}
        }
      }
    },
    "implementationSteps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "testStrategy": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "acceptanceMapping": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterionIndex", "verification"],
        "properties": {
          "criterionIndex": {"type": "integer", "minimum": 1},
          "verification": {"type": "string", "minLength": 1, "maxLength": 4096}
        }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "assumptions": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    }
  }
}
