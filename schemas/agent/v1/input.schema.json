{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign.ai/schemas/agent/v1/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workflowId", "stepName", "attempt", "role", "goal", "workspacePath", "stagingPath"],
  "properties": {
    "schemaVersion": { "const": "sovereign.ai/agent-contract/v1" },
    "workflowId": { "type": "string", "minLength": 1 },
    "stepName": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "role": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "inputs": { "type": "array" },
    "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "inferenceEndpoint": { "type": "string" },
    "mcpServer": { "type": "string" },
    "workspacePath": { "type": "string", "minLength": 1 },
    "stagingPath": { "type": "string", "minLength": 1 }
  }
}
