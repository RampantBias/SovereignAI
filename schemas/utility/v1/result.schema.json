{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign.ai/schemas/utility/v1/result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "outcome"],
  "properties": {
    "schemaVersion": { "const": "sovereign.ai/utility-contract/v1" },
    "outcome": { "enum": ["Succeeded", "Failed", "Intervention"] },
    "message": { "type": "string" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contract", "path"],
        "properties": {
          "contract": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "mediaType": { "type": "string", "minLength": 1 }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
